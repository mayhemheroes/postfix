# RFC 822 address/token grammar tokens for tok822_parse (src/global/tok822_parse.c).
at="@"
comma=","
colon=":"
semicolon=";"
langle="<"
rangle=">"
lparen="("
rparen=")"
lbracket="["
rbracket="]"
dquote="\""
dot="."
backslash="\\"
crlf="\x0d\x0a"
group="group:"
example="example.com"
domain_literal="[127.0.0.1]"
quoted="\"a b\""
route="@host:user@dom"
