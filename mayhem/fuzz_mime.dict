# MIME / message header keywords for mime_state_update (src/global/mime_state.c, header_*).
crlf="\x0d\x0a"
hdr_end="\x0d\x0a\x0d\x0a"
content_type="Content-Type:"
content_te="Content-Transfer-Encoding:"
mime_version="Mime-Version: 1.0"
multipart="multipart/mixed"
alternative="multipart/alternative"
text_plain="text/plain"
msg_rfc822="message/rfc822"
boundary="boundary="
boundary_mark="--"
base64="base64"
qp="quoted-printable"
sevenbit="7bit"
eightbit="8bit"
charset="charset="
utf8="utf-8"
encoded_word="=?utf-8?B?"
from="From:"
subject="Subject:"
